# Sao chep file nay thanh ".env" va chinh lai gia tri cho dung moi truong that

# Cong chay Backend/API
# Luu y: PORT 3000 co the dang bi chiem boi ung dung Node khac tren may ban,
# nen mac dinh chon 4000. Doi lai neu can.
PORT=4000

# ==== MySQL (XAMPP) ====
# Lan chay dau, neu chua co database thi Backend tu tao tu database/iot_system.sql
DB_HOST=172.11.82.108
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_system

# Mui gio dung khi tim kiem theo thoi gian hien thi tren giao dien
APP_TZ=+07:00

# Khoa bi mat de ky JWT (nen doi thanh chuoi ngau nhien khi trien khai that)
JWT_SECRET=change-this-secret-key
JWT_EXPIRES_IN=8h

# ==== MQTT Broker (Mosquitto) ====
# Sua dia chi broker neu Backend va broker chay tren hai may khac nhau.
# Neu doi mang/doi broker, chi can sua cac gia tri duoi day (khong can sua code).
MQTT_HOST=127.0.0.1
MQTT_PORT=8888
MQTT_USERNAME=iot_device
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_CLIENT_ID=iot-backend

# Topic MQTT (phai khop voi firmware ESP8266)
MQTT_TOPIC_TELEMETRY=datasensors
MQTT_TOPIC_CONTROL=devicecontrol
MQTT_TOPIC_RESPONSE=deviceresponse
MQTT_TOPIC_STATUS=devicestatus

# Payload dang chuoi text (khong co device_id) se duoc gan cho thiet bi nay
MQTT_LEGACY_DEVICE_ID=esp8266-01

# So giay khong nhan telemetry thi coi thiet bi la offline
DEVICE_OFFLINE_TIMEOUT_SEC=15

# So giay cho ACK truoc khi coi lenh dieu khien la timeout
COMMAND_TIMEOUT_SEC=10
